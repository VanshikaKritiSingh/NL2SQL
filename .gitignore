# Ignore untracked binaries
*.exe
*.dll

# OS / Editor artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/

# Node / Frontend / Desktop build artifacts
node_modules/
.npm-cache/
dist/
dist-electron/
*.tsbuildinfo

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
.venv*/
env/
.pip-cache/
.pytest_cache/

# ML / AI Large Files & Model Checkpoints (Keeps GitHub Repo Volume Minimal)
*.safetensors
*.bin
*.pt
*.pth
*.gguf
*.onnx
offline/checkpoints/*
!offline/checkpoints/.gitkeep
offline/models/*
!offline/models/.gitkeep
!offline/models/README.md
/models/
/checkpoints/

# Generated Local Datasets & Raw Cache (Not pushed to GitHub)
offline/datasets/*.json
offline/datasets/*.jsonl
offline/datasets/*.parquet
offline/datasets/raw/
data/
/datasets/
!offline/datasets/.gitkeep

# RLAIF Engine & Local Document Pool (Unfollowed local directory)
rlaif_engine/documents/*
!rlaif_engine/documents/.gitkeep
rlaif_engine/trajectories/*
!rlaif_engine/trajectories/.gitkeep
rlaif_engine/*.db
.env

# ML Logs & Telemetry
wandb/
runs/
lightning_logs/
.cache/

# Hide directories from GitHub
offline/datasets/dialects/
validator/
test/
tests/
